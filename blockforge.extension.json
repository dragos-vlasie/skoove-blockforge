{
  "schemaVersion": 1,
  "id": "skoove-client",
  "name": "Skoove client components",
  "version": "1.0.0",
  "repository": "dragos-vlasie/skoove-blockforge",
  "blocks": [
    {
      "type": "CUSTOM:SKOOVE_LEARNING_PATH_HERO",
      "label": "Skoove learning path hero",
      "shortLabel": "SK",
