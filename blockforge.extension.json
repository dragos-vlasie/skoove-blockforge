      "category": "Skoove",
      "viewModule": "src/client-extensions/SkooveLearningPathHero",
      "defaultContent": {
        "eyebrow": "Learn piano your way",
        "title": "A learning path that moves at your pace",
        "description": "Build confidence with interactive lessons, real-time feedback, and songs you actually want to play.",
        "primaryCtaLabel": "Start learning",
        "primaryCtaHref": "/start/",
        "secondaryCtaLabel": "Explore lessons",
        "secondaryCtaHref": "/lessons/",
        "trustLine": "Trusted by piano learners around the world"
      },
      "fields": [
        { "id": "eyebrow", "label": "Eyebrow", "type": "text" },
        { "id": "title", "label": "Title", "type": "textarea", "required": true },
        { "id": "description", "label": "Description", "type": "textarea", "required": true },
        { "id": "primaryCtaLabel", "label": "Primary button label", "type": "text", "required": true },
        { "id": "primaryCtaHref", "label": "Primary button URL", "type": "url", "required": true },
        { "id": "secondaryCtaLabel", "label": "Secondary button label", "type": "text" },
        { "id": "secondaryCtaHref", "label": "Secondary button URL", "type": "url" },
        { "id": "trustLine", "label": "Trust line", "type": "text" }
      ]
    }
  ]
}
