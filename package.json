{
  "name": "blockforge-cms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/admin",
    "apps/site",
    "packages/*"
  ],
  "scripts": {
    "predev": "node scripts/generate-next-block-registry.mjs && node scripts/generate-client-extension-registry.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-next-block-registry.mjs && node scripts/generate-client-extension-registry.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "dev:admin": "npm run dev --workspace @blockforge/admin",
    "dev:site": "npm run dev --workspace @blockforge/site",
    "build:admin": "npm run build --workspace @blockforge/admin",
    "build:site": "npm run build --workspace @blockforge/site",
    "typecheck:workspaces": "npm run typecheck --workspace @blockforge/admin && npm run typecheck --workspace @blockforge/site",
    "typecheck": "tsc --noEmit",
    "wp:audit": "node --import tsx scripts/wordpress-import.ts audit",
    "wp:import": "node --import tsx scripts/wordpress-import.ts document",
    "wp:import:site": "node --import tsx scripts/wordpress-import.ts site",
    "wp:apply": "node --import tsx scripts/wordpress-import.ts apply",
    "test": "npm run test:unit && npm run test:smoke && npm run test:e2e",
    "test:unit": "node --test tests/rich-text-editor.test.mjs tests/block-registry.test.mjs tests/content-storage.test.mjs tests/media-library.test.mjs tests/content-model-builder.test.mjs tests/public-css-guard.test.mjs",
    "test:smoke": "node --test tests/website-smoke.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@blockforge/preview": "file:vendor/blockforge-preview-0.1.0.tgz",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@google/genai": "1.40.0",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tiptap/extension-link": "2.27.2",
    "@tiptap/extension-placeholder": "2.27.2",
    "@tiptap/extension-subscript": "^2.27.2",
    "@tiptap/extension-superscript": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/react": "2.27.2",
    "@tiptap/starter-kit": "2.27.2",
    "commander": "^15.0.0",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-select": "^6.0.4",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-text": "^4.0.2",
    "next": "^16.2.9",
    "p-limit": "^7.3.1",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "3.10.1",
    "rehype-parse": "^9.0.1",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "supabase": "2.117.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2"
  }
}
