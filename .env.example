# CMS login
CMS_ADMIN_PASSWORD=change-me
CMS_SESSION_SECRET=replace-with-a-long-random-secret
# Code-mode preview secrets are derived from CMS_SESSION_SECRET and provisioned automatically.
# Recommended account login. CMS_SUPABASE_URL can be reused from Storage below.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated Supabase Auth emails that can access every client.
CMS_PLATFORM_ADMIN_EMAILS=
# Public URL of the central CMS, used for Supabase owner invitation redirects.
CMS_APP_URL=
# Public URL client sites use to fetch published content. Defaults to CMS_APP_URL.
BLOCKFORGE_CONTENT_API_URL=
# Optional separate analytics receiver. Defaults to BLOCKFORGE_CONTENT_API_URL.
BLOCKFORGE_ANALYTICS_API_URL=
# Client-site cache interval for published content.
BLOCKFORGE_CONTENT_REVALIDATE_SECONDS=60

# Content storage
# local = read/write content/draft and content/published on disk
# github = read/write those same JSON files through GitHub commits
# database = read/write draft and published JSON snapshots in Postgres jsonb
# remote = read published content from the central BlockForge API (client sites only)
CMS_CONTENT_STORE=local
# Optional override for monorepo local-content development.
CMS_LOCAL_CONTENT_ROOT=

# Database content storage
# Required when CMS_CONTENT_STORE=database.
# CMS_DATABASE_URL is preferred; DATABASE_URL is supported as a fallback.
CMS_DATABASE_URL=
CMS_TENANT_ID=local
CMS_SITE_ID=main
# Optional. Use require for Supabase if your connection string does not include sslmode=require.
CMS_DATABASE_SSL=
# true = create CMS tables automatically on first use
CMS_DATABASE_AUTO_MIGRATE=true
# Optional legacy hook. Central provisioning triggers the configured provider directly.
CMS_PUBLISH_WEBHOOK_URL=

# Deployment provider used by Add client. Vercel is the default.
CMS_DEPLOYMENT_PROVIDER=vercel

# Vercel client provisioning (central CMS only)
# Personal Hobby accounts do not need VERCEL_TEAM_ID or VERCEL_TEAM_SLUG.
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=
VERCEL_GIT_REPOSITORY=owner/repo
VERCEL_GIT_BRANCH=master
VERCEL_ROOT_DIRECTORY=apps/site
# Optional default root for Code-mode repositories. The onboarding form can override it.
VERCEL_CODE_ROOT_DIRECTORY=apps/site
VERCEL_PROJECT_NAME_PREFIX=blockforge

# Legacy Netlify client provisioning
# The access token is never copied to client deployments. Each provisioned
# site receives only its own build-hook URL.
NETLIFY_ACCESS_TOKEN=
NETLIFY_ACCOUNT_SLUG=
NETLIFY_GIT_PROVIDER=github
# Required when Add client should create a new Netlify project. Existing
# project connections keep their current repository configuration.
NETLIFY_GIT_REPOSITORY=owner/repo
NETLIFY_GIT_BRANCH=main
# Required for private repositories connected through the Netlify GitHub App.
NETLIFY_GIT_INSTALLATION_ID=
NETLIFY_BASE_DIRECTORY=
NETLIFY_SITE_NAME_PREFIX=blockforge

# Media storage
# local = write uploaded files to public/uploads
# github = commit uploaded/replaced files to GitHub under public/uploads
# supabase = upload/replace/delete files in Supabase Storage
# Defaults to github only when CMS_CONTENT_STORE=github; otherwise defaults to local.
CMS_MEDIA_STORE=local

# Supabase media storage
# Required when CMS_MEDIA_STORE=supabase.
# Use a Supabase Secret key from Project Settings > API Keys.
# This must stay server-side. Do not expose it in client code.
CMS_SUPABASE_URL=
CMS_SUPABASE_SECRET_KEY=
CMS_SUPABASE_STORAGE_BUCKET=cms-media

# GitHub content storage
# Required when CMS_CONTENT_STORE=github or CMS_MEDIA_STORE=github.
CMS_GITHUB_TOKEN=
CMS_GITHUB_REPO=owner/repo
CMS_GITHUB_BRANCH=main

# Optional GitHub content storage settings
CMS_GITHUB_CONTENT_ROOT=content
CMS_GITHUB_API_URL=https://api.github.com
CMS_GITHUB_COMMIT_AUTHOR_NAME=BlockForge CMS
CMS_GITHUB_COMMIT_AUTHOR_EMAIL=cms@example.com

# AI content helper
# GEMINI_API_KEY is preferred. API_KEY is also supported as a fallback.
GEMINI_API_KEY=
API_KEY=

# Test/dev overrides
PLAYWRIGHT_PORT=4173
